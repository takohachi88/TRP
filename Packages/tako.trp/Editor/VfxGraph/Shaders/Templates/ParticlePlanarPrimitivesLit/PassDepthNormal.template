// TRP DepthNormals pass。Normal MapとNormal BendingをForwardと同じ条件で反映する。
Pass
{
	Name ${VFXPassDepthNormal}
	Tags { "LightMode"=${VFXPassDepthNormal} }

	ZWrite On
	Blend Off

	HLSLPROGRAM
	#define VFX_PASSDEPTH VFX_PASSDEPTH_ACTUAL
	#define WRITE_NORMAL_BUFFER
	${VFXPassDepthAdditionalPragma}
	${VFXIncludeRP("Templates/ParticlePlanarPrimitivesLit/PassDepth.template")}
	ENDHLSL
}
